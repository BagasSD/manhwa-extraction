# Copy this file to .env and adjust as needed.

APP_ENV=development

# =====================================================================
# Ollama Configuration (Local vs Cloud)
# =====================================================================

# Set to true if using Cloud / Remote endpoint, or false if running Ollama locally on this machine
OLLAMA_IS_CLOUD=false

# API Token / Key if using an authenticated Ollama Cloud or remote proxy (optional)
OLLAMA_API_TOKEN=

# Host URL:
# - For Local: http://localhost:11434
# - For Cloud: https://api.ollama.com (or custom proxy/cloud URL)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CLOUD_HOST=https://api.ollama.com

# Model name (e.g. gemma4:31b-cloud, llama3.2-vision, minicpm-v, llava)
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0
OLLAMA_VISUAL_TOKENS=1120
OLLAMA_TIMEOUT=120.0

# =====================================================================
# Page extraction strategy
# =====================================================================

# Preprocessing for batch/single-page extraction: original, enhanced, tiled, ...
# "tiled" = split tall pages into upscaled vertical segments (crop + upscale).
EXTRACTION_PREPROCESS_MODE=original
# Send the output JSON schema to Ollama (structured outputs). Set false if the
# model/host rejects schema-constrained `format`.
EXTRACTION_STRUCTURED_OUTPUT=true
EXTRACTION_MAX_TEMPERATURE=0.2
EXTRACTION_TILE_MAX_SEGMENTS=8
EXTRACTION_TILE_MIN_WIDTH=1024

# =====================================================================
# Export
# =====================================================================

# Text types left out of TXT/JSON exports and chapter context (JSON list).
# They are still extracted and shown in the review UI. [] keeps everything.
EXPORT_EXCLUDED_TEXT_TYPES=["sfx"]

