# Copy this file to .env and adjust as needed.

APP_ENV=development

# =====================================================================
# Ollama Configuration (Local vs Cloud)
# =====================================================================

# Set to true if using Cloud / Remote endpoint, or false if running Ollama locally on this machine
OLLAMA_IS_CLOUD=false

# API Token / Key if using an authenticated Ollama Cloud or remote proxy (optional)
OLLAMA_API_TOKEN=

# Host URL:
# - For Local: http://localhost:11434
# - For Cloud: https://api.ollama.com (or custom proxy/cloud URL)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CLOUD_HOST=https://api.ollama.com

# Model name (e.g. gemma4:31b-cloud, llama3.2-vision, minicpm-v, llava)
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0
OLLAMA_VISUAL_TOKENS=1120
OLLAMA_TIMEOUT=120.0

